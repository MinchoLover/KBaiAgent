# Main Agent
APP_ENV=development
DEMO_MODE=true

# OpenAI: document extraction and explanatory report only
OPENAI_API_KEY=
OPEN_AI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o
OPENAI_REPORT_MODEL=gpt-4o-mini
OPENAI_RAG_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Stage 1 integration: http | file | mock
STAGE1_MODE=web_forecast
STAGE1_PROVIDER=http
STAGE1_BASE_URL=http://127.0.0.1:8765
STAGE1_FORECAST_FILE=src/integration_assets/stage1/latest_forecast.json
STAGE1_HTTP_TIMEOUT_SECONDS=10
STAGE1_HTTP_RETRIES=1
STAGE1_MAX_RESPONSE_BYTES=1048576
STAGE1_MAX_STALENESS_MARKET_DAYS=3
STAGE1_MAX_PATH_RETURN=0.50
STAGE1_ALLOW_PRIVATE_ENDPOINTS=false
STAGE1_ALLOWED_HOSTS=

# Spot rate: auto | koreaexim | manual | fixture
SPOT_RATE_PROVIDER=manual
MANUAL_USDKRW_RATE=
KOREAEXIM_KEY=
ECOS_KEY=
CREDIT_KEY=

# Feature switches
ENABLE_DOCUMENT_AI=true
ENABLE_LIVE_DOCUMENT_EXTRACTION=true
ENABLE_STAGE3_OPTIMIZER=true
ENABLE_KB_MACRO_HEDGE_REFERENCE=false
ENABLE_PRODUCT_RAG=true
ENABLE_LLM_REPORT=true
ENABLE_OFFICIAL_WEB_SEARCH=false

# Optional kb_macro_ai hedge reference: off | fixture | file | local_cli
# This never replaces Stage 3. Use absolute allowed root and pinned hashes.
KB_MACRO_HEDGE_MODE=off
KB_MACRO_HEDGE_ALLOWED_ROOT=
KB_MACRO_FORECAST_FILE=
KB_MACRO_HEDGE_FILE=
KB_MACRO_MODEL_CONFIG_FILE=configs/hedge_recommendation_v1.json
KB_MACRO_MARKET_HISTORY_FILE=web_runtime/bundle_v1/market_history.csv
KB_MACRO_QUOTE_TEMPLATE_FILE=examples/mock_company_exposure.json
KB_MACRO_EXPECTED_PROVIDER_COMMIT_SHA=
KB_MACRO_EXPECTED_FORECAST_SHA256=
KB_MACRO_EXPECTED_HEDGE_SHA256=
KB_MACRO_EXPECTED_MODEL_CONFIG_SHA256=
KB_MACRO_EXPECTED_MARKET_HISTORY_SHA256=
KB_MACRO_EXPECTED_QUOTE_TEMPLATE_SHA256=
KB_MACRO_MAX_FILE_BYTES=1048576
KB_MACRO_CLI_TIMEOUT_SECONDS=30
KB_MACRO_CLI_MAX_OUTPUT_BYTES=65536

# File and retrieval safety
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=20
OFFICIAL_SEARCH_CACHE_TTL_HOURS=24
OFFICIAL_DOMAINS=kbstar.com,kbfg.com,ksure.or.kr,kosmes.or.kr,bizinfo.go.kr,kodit.co.kr,kibo.or.kr
