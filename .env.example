# KBaiAgent environment template
# This file is safe to commit. Keep secret values empty in Git.

# -----------------------------------------------------------------------------
# Application execution
# -----------------------------------------------------------------------------
# development | presentation
APP_ENV=development
# Internal trace/JSON is shown only when APP_ENV=development and this is true.
SHOW_INTERNAL_DEBUG=false
# Enables registered synthetic demos and fixture fallback paths.
DEMO_MODE=true
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=20

# -----------------------------------------------------------------------------
# OpenAI document extraction and report explanation
# -----------------------------------------------------------------------------
# Optional. Empty means registered demos and deterministic report fallback only.
OPENAI_API_KEY=
# Legacy alias read only when OPENAI_API_KEY is empty.
OPEN_AI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o
OPENAI_REPORT_MODEL=gpt-4o-mini
OPENAI_RAG_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
ENABLE_DOCUMENT_AI=true
ENABLE_LIVE_DOCUMENT_EXTRACTION=true
ENABLE_LLM_REPORT=true
ENABLE_COUNTRY_ECONOMIC_INTERPRETATION=false
ENABLE_TRADE_STATISTICS_INTERPRETATION=false

# -----------------------------------------------------------------------------
# Stage 1 exchange-rate forecast adapter
# -----------------------------------------------------------------------------
# manual | web_forecast | external_stage1
STAGE1_MODE=web_forecast
# http | file | mock
STAGE1_PROVIDER=file
STAGE1_BASE_URL=http://127.0.0.1:8765
STAGE1_FORECAST_FILE=src/integration_assets/stage1/latest_forecast.json
STAGE1_TIMEOUT_SECONDS=10
STAGE1_HTTP_TIMEOUT_SECONDS=10
STAGE1_HTTP_RETRIES=1
STAGE1_MAX_RESPONSE_BYTES=1048576
STAGE1_MAX_STALENESS_MARKET_DAYS=3
STAGE1_MAX_PATH_RETURN=0.50
STAGE1_ALLOW_PRIVATE_ENDPOINTS=false
# Comma-separated remote host allowlist. Localhost is handled by the adapter.
STAGE1_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# Spot rate and public-data APIs
# -----------------------------------------------------------------------------
# auto | koreaexim | manual | fixture
SPOT_RATE_PROVIDER=fixture
MANUAL_USDKRW_RATE=
# Optional secrets. Never commit actual values.
KOREAEXIM_KEY=
CUSTOMS_TRADE_API_KEY=
# Read by Settings for future/optional providers; not required by Golden Demo.
ECOS_KEY=
CREDIT_KEY=

# auto | live | fixture
# auto uses the verified fixture for the registered Golden trade and live
# Korea Customs API for ordinary uploaded transactions.
TRADE_STATISTICS_PROVIDER=auto
TRADE_STATISTICS_TIMEOUT_SECONDS=10
TRADE_STATISTICS_SNAPSHOT_VERSION=2026.08.01-kr-br-country-v1

# -----------------------------------------------------------------------------
# Product/reference integrations and feature switches
# -----------------------------------------------------------------------------
ENABLE_STAGE3_OPTIMIZER=true
ENABLE_PRODUCT_RAG=true
ENABLE_OFFICIAL_WEB_SEARCH=false
OFFICIAL_SEARCH_CACHE_TTL_HOURS=24
OFFICIAL_DOMAINS=kbstar.com,kbfg.com,ksure.or.kr,kosmes.or.kr,bizinfo.go.kr,kodit.co.kr,kibo.or.kr

# Optional external kb_macro_ai reference. It never replaces Stage 3.
ENABLE_KB_MACRO_HEDGE_REFERENCE=false
# off | fixture | file | local_cli
KB_MACRO_HEDGE_MODE=off
KB_MACRO_HEDGE_ALLOWED_ROOT=
KB_MACRO_FORECAST_FILE=
KB_MACRO_HEDGE_FILE=
KB_MACRO_MODEL_CONFIG_FILE=configs/hedge_recommendation_v1.json
KB_MACRO_MARKET_HISTORY_FILE=web_runtime/bundle_v1/market_history.csv
KB_MACRO_QUOTE_TEMPLATE_FILE=examples/mock_company_exposure.json
KB_MACRO_EXPECTED_PROVIDER_COMMIT_SHA=
KB_MACRO_EXPECTED_FORECAST_SHA256=
KB_MACRO_EXPECTED_HEDGE_SHA256=
KB_MACRO_EXPECTED_MODEL_CONFIG_SHA256=
KB_MACRO_EXPECTED_MARKET_HISTORY_SHA256=
KB_MACRO_EXPECTED_QUOTE_TEMPLATE_SHA256=
KB_MACRO_MAX_FILE_BYTES=1048576
KB_MACRO_CLI_TIMEOUT_SECONDS=30
KB_MACRO_CLI_MAX_OUTPUT_BYTES=65536

# -----------------------------------------------------------------------------
# PDF output
# -----------------------------------------------------------------------------
# Optional Unicode Korean font path. Empty enables safe OS font discovery.
KBAI_CONSULTATION_PDF_FONT=
